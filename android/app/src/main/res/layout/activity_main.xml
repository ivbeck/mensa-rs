<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/paper"
    android:orientation="vertical"
    android:paddingStart="@dimen/screen_padding_h"
    android:paddingTop="@dimen/screen_padding_top"
    android:paddingEnd="@dimen/screen_padding_h">

    <!-- Kicker row -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:baselineAligned="false"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            app:fontFamily="@font/spacemono_regular"
            android:letterSpacing="0.18"
            android:text="@string/kicker"
            android:textColor="@color/ink_muted"
            android:textSize="@dimen/text_kicker" />

        <TextView
            android:id="@+id/filter_button"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="?attr/selectableItemBackgroundBorderless"
            app:fontFamily="@font/spacemono_bold"
            android:letterSpacing="0.14"
            android:paddingStart="@dimen/spacing_sm"
            android:paddingTop="@dimen/spacing_xs"
            android:paddingEnd="@dimen/spacing_xs"
            android:paddingBottom="@dimen/spacing_xs"
            android:text="@string/filter_label"
            android:textColor="@color/ink_muted"
            android:textSize="@dimen/text_kicker" />

    </LinearLayout>

    <!-- Masthead -->
    <TextView
        android:id="@+id/header"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/spacing_md"
        app:fontFamily="@font/anton"
        android:includeFontPadding="false"
        android:letterSpacing="-0.01"
        android:text="@string/masthead_line1"
        android:textColor="@color/ink"
        android:textSize="@dimen/text_masthead" />

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <View
            android:layout_width="13dp"
            android:layout_height="13dp"
            android:layout_marginEnd="@dimen/spacing_sm"
            android:background="@color/accent" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:fontFamily="@font/anton"
            android:includeFontPadding="false"
            android:letterSpacing="0.02"
            android:text="@string/masthead_line2"
            android:textColor="@color/ink"
            android:textSize="@dimen/text_masthead_sub" />

    </LinearLayout>

    <!-- Thick rule under masthead -->
    <View
        android:layout_width="match_parent"
        android:layout_height="@dimen/rule_thick"
        android:layout_marginTop="@dimen/spacing_lg"
        android:background="@color/rule_strong" />

    <!-- Date line -->
    <TextView
        android:id="@+id/subheader"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/spacing_md"
        app:fontFamily="@font/spacemono_regular"
        android:letterSpacing="0.08"
        android:textAllCaps="true"
        android:textColor="@color/ink_muted"
        android:textSize="@dimen/text_dateline" />

    <!-- Date strip -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/date_strip"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/spacing_md"
        android:clipToPadding="false"
        android:overScrollMode="never" />

    <!-- Hairline under date strip -->
    <View
        android:layout_width="match_parent"
        android:layout_height="@dimen/rule_hair_height"
        android:layout_marginTop="@dimen/spacing_md"
        android:background="@color/rule_hair" />

    <!-- Meal list + states -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/meal_list"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:overScrollMode="never"
            android:paddingBottom="@dimen/spacing_xl" />

        <LinearLayout
            android:id="@+id/loading_view"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:orientation="vertical"
            android:visibility="gone">

            <TextView
                app:fontFamily="@font/spacemono_regular"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:letterSpacing="0.3"
                android:text="@string/loading_message"
                android:textColor="@color/ink_muted"
                android:textSize="@dimen/text_state" />

        </LinearLayout>

        <LinearLayout
            android:id="@+id/error_view"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:orientation="vertical"
            android:paddingStart="@dimen/spacing_xl"
            android:paddingEnd="@dimen/spacing_xl"
            android:visibility="gone">

            <TextView
                android:id="@+id/error_message"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:fontFamily="@font/spectral_italic"
                android:gravity="center"
                android:textColor="@color/error"
                android:textSize="@dimen/text_meal_title" />

            <TextView
                android:id="@+id/retry_button"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_lg"
                android:background="?attr/selectableItemBackground"
                app:fontFamily="@font/spacemono_bold"
                android:letterSpacing="0.14"
                android:paddingStart="@dimen/spacing_md"
                android:paddingTop="@dimen/spacing_sm"
                android:paddingEnd="@dimen/spacing_md"
                android:paddingBottom="@dimen/spacing_sm"
                android:text="@string/retry_label"
                android:textColor="@color/accent"
                android:textSize="@dimen/text_kicker" />

        </LinearLayout>

        <LinearLayout
            android:id="@+id/empty_view"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:orientation="vertical"
            android:paddingStart="@dimen/spacing_xl"
            android:paddingEnd="@dimen/spacing_xl"
            android:visibility="gone">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:fontFamily="@font/spectral_italic"
                android:gravity="center"
                android:text="@string/empty_message"
                android:textColor="@color/ink_muted"
                android:textSize="@dimen/text_meal_title" />

        </LinearLayout>

    </FrameLayout>

</LinearLayout>
